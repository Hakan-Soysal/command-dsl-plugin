#!/usr/bin/env bash
# pre-push — plugin push'unu iki eksende denetler:
#   (1) plugin-lokal wrapper (.src.mts) drifti dahil skill-bundle BAYATLIĞI (Faz-3, 2026-07-17)
#   (2) skills/** değişip plugin.json SÜRÜMÜ değişmemişse DUR (iki-klon kanonikleştirme, 2026-08-04)
#
# (1) CommandDSL'in .githooks/pre-push emsalinin SİMETRİĞİ: orada gramer push'u kardeş plugin'i
# denetler (plugin yoksa graceful atlar); burada plugin push'u check-skill-staleness'ı koşar
# (CommandDSL bulunamazsa UYARIP GEÇER — push engellenmez; plugin-only wrapper push'u aksi
# halde tamamen denetimsizdi).
#
# (2) NEDEN: yayınlanan kopyanın cache ANAHTARI plugin.json'daki SÜRÜMDÜR. Cache dizini
# ~/.claude/plugins/cache/command-dsl-tools/command-dsl/<sürüm>/ altında açılır; içerik değişip
# sürüm bumplanmazsa YENİ dizin oluşmaz ve ESKİ kopya koşmaya devam eder — sessiz bayatlık.
# post-commit auto-bump yalnız feat:/fix: commit'lerini bumplar; chore/docs/refactor tipli bir
# bundle re-anchor'ı sessizce bumpsuz kalır (emsal: f206f75 'chore(skills): … re-anchor',
# ebeveyn 0.46.0 → kendisi 0.46.0). Bu kapı tam o boşluğu kapatır.
# Karşılaştırma ALAN düzeyindedir (plugin.json'un değişmiş olması YETMEZ — `version` değişmeli)
# ve push edilen ARALIK üzerinden yapılır (remote_sha..local_sha, stdin'den).
#
# CMDDSL aday yolları: env CMDDSL > $REPO_ROOT/../CommandDSL > $REPO_ROOT/../../CommandDSL.
# Acil durum bypass: git push --no-verify
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CHECK="$REPO_ROOT/scripts/check-skill-staleness.mjs"
PLUGIN_JSON="plugins/command-dsl/.claude-plugin/plugin.json"
SKILLS_PATH="plugins/command-dsl/skills"
ZERO="0000000000000000000000000000000000000000"

# stdin'i ÖNCE oku: git pre-push'a "<local_ref> <local_sha> <remote_ref> <remote_sha>" satırları
# verir; aşağıdaki node çağrısı stdin'i tüketebilir.
PUSH_REFS="$(cat)"

# ── (1) skill-bundle bayatlığı ──────────────────────────────────────────────────────────────
CANDIDATES=()
[ -n "${CMDDSL:-}" ] && CANDIDATES+=("$CMDDSL")
CANDIDATES+=("$REPO_ROOT/../CommandDSL" "$REPO_ROOT/../../CommandDSL")

FOUND=""
for c in "${CANDIDATES[@]}"; do
    if [ -f "$c/command-dsl.langium" ]; then FOUND="$c"; break; fi
done

if [ -z "$FOUND" ]; then
    echo "pre-push UYARI: CommandDSL bulunamadı — skill-bayatlık denetimi ATLANDI (push engellenmedi)." >&2
    echo "  Denenen: ${CANDIDATES[*]}" >&2
    echo "  İstersen CMDDSL=<yol> git push ile denetimli push yap." >&2
else
    echo "pre-push (1): skill bundle bayatlık denetimi (CommandDSL: $FOUND)…" >&2
    if ! CMDDSL="$FOUND" node "$CHECK"; then
        echo "" >&2
        echo "pre-push DURDU (1): bundle/envanter/referans bayat — CommandDSL-drift YA DA plugin-wrapper" >&2
        echo "  drifti (elle değişen .src.mts rebuild edilmemiş) olabilir (yukarıdaki eksene bak)." >&2
        echo "  Düzelt: STALE skil(ler)in validator/ dizininde her build.*.mjs'i CMDDSL='$FOUND'" >&2
        echo "          ile koştur (aile-eşzamanlı) + gerekirse referans/envanter güncelle." >&2
        echo "  Acil bypass (bilinçli): git push --no-verify" >&2
        exit 1
    fi
fi

# ── (2) sürüm-bump kapısı: skills/** değişti ama plugin.json `version` alanı değişmediyse DUR ─
plugin_version() {  # $1 = commit-ish; boş basar (yoksa/okunamazsa)
    git -C "$REPO_ROOT" show "$1:$PLUGIN_JSON" 2>/dev/null \
        | grep -m1 -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' \
        | grep -o '"[^"]*"$' | tr -d '"'
}

VERSION_FAIL=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue   # dal silme → denetlenecek içerik yok

    BASE="$remote_sha"
    if [ "$BASE" = "$ZERO" ] || [ -z "$BASE" ]; then
        # yeni dal: uzakta karşılığı yok → origin/main'i taban al; o da yoksa denetim ATLANIR
        BASE="$(git -C "$REPO_ROOT" rev-parse --verify --quiet refs/remotes/origin/main 2>/dev/null)"
        if [ -z "$BASE" ]; then
            echo "pre-push UYARI (2): '$local_ref' için taban commit yok (yeni dal, origin/main de yok)" >&2
            echo "  → sürüm-bump denetimi bu ref için ATLANDI." >&2
            continue
        fi
    fi

    CHANGED="$(git -C "$REPO_ROOT" diff --name-only "$BASE" "$local_sha" -- "$SKILLS_PATH" 2>/dev/null)"
    [ -z "$CHANGED" ] && continue

    OLD_V="$(plugin_version "$BASE")"
    NEW_V="$(plugin_version "$local_sha")"
    if [ "$OLD_V" = "$NEW_V" ]; then
        echo "" >&2
        echo "pre-push DURDU (2): '$local_ref' skills/** değiştiriyor ama plugin SÜRÜMÜ aynı kalmış." >&2
        echo "  Aralık:  ${BASE:0:9}..${local_sha:0:9}" >&2
        echo "  Sürüm:   $OLD_V → $NEW_V  (DEĞİŞMEDİ)" >&2
        echo "  Değişen skill dosyaları:" >&2
        printf '%s\n' "$CHANGED" | head -20 | while IFS= read -r l; do echo "    $l" >&2; done
        echo "  Neden: sürüm CACHE ANAHTARIDIR — bumplanmazsa Claude eski cache kopyasını koşmaya" >&2
        echo "         devam eder; yeni skill içeriği hiç yüklenmez (sessiz bayatlık)." >&2
        echo "  Düzelt: scripts/bump-version.sh patch|minor|major   (plugin.json + marketplace.json)" >&2
        echo "          sonra bumpı commit'e katla: git commit --amend --no-edit  (ya da ayrı commit)." >&2
        echo "  Not: post-commit auto-bump YALNIZ feat:/fix: tipli commit'lerde çalışır;" >&2
        echo "       chore/docs/refactor tipli bundle re-anchor'larında bumpı ELLE yapman gerekir." >&2
        echo "  Acil bypass (bilinçli): git push --no-verify" >&2
        VERSION_FAIL=1
    fi
done <<< "$PUSH_REFS"

[ "$VERSION_FAIL" -eq 1 ] && exit 1
exit 0
